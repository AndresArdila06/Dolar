# Credenciales de la aplicación en Microsoft Entra ID (Azure AD)
# Permisos requeridos en Microsoft Graph (Application): Files.ReadWrite.All, Mail.Send
AZURE_TENANT_ID=tu-tenant-id
AZURE_CLIENT_ID=tu-client-id
AZURE_CLIENT_SECRET=tu-client-secret

# OneDrive donde se guarda el consolidado mensual (ej. Dolar/2026/Noviembre 2026.xlsx)
ONEDRIVE_USER_EMAIL=usuario@empresa.com
ONEDRIVE_BASE_FOLDER=Dolar

# Envío de correo diario (separa múltiples destinatarios con coma)
MAIL_FROM=remitente@empresa.com
MAIL_TO=destinatario@empresa.com